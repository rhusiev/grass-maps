<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug builds install the StrictMode policy checked by CI. The cleartext
         exception is loopback only, for the local region-download server; a
         release build has no such config and targetSdk 36 refuses cleartext. -->
    <application
        android:name="nl.r1a.grassmap.app.DebugApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:name">

        <!-- T-0416: the document source for the share-sheet import's device check
             and instrumented test. Debug only, not exported: another app's share
             is a content:// URI, and a plain file cannot exercise the resolver. -->
        <provider
            android:name="nl.r1a.grassmap.app.SharedTrackTestProvider"
            android:authorities="nl.r1a.grassmap.share-test"
            android:exported="false" />
    </application>
</manifest>
