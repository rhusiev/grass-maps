<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only: the region-download evidence server runs on the emulator host and
  is reached through `adb reverse`. Cleartext is permitted for loopback alone;
  every other host still needs HTTPS, and release builds have no config here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
