<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name="nl.r1a.grassmap.app.GrassMapsApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="nl.r1a.grassmap.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T-0211: geo: links and osm.org pages from other apps. The app
                 offers itself as the default maps app through this filter. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.openstreetmap.org" />
                <data android:scheme="http" android:host="www.openstreetmap.org" />
                <data android:scheme="https" android:host="openstreetmap.org" />
                <data android:scheme="http" android:host="openstreetmap.org" />
                <data android:scheme="https" android:host="osm.org" />
                <data android:scheme="http" android:host="osm.org" />
                <data android:scheme="https" android:host="www.osm.org" />
                <data android:scheme="http" android:host="www.osm.org" />
                <!-- Only the paths the router opens. Android flattens the data
                     lists of one filter, so these paths apply to every host
                     above; the root path is the permalink form. -->
                <data android:path="/" />
                <data android:pathPrefix="/node/" />
                <data android:pathPrefix="/way/" />
                <data android:pathPrefix="/relation/" />
                <data android:pathPrefix="/go/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
