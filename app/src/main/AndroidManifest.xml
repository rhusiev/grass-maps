<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- T-0314: the navigation foreground service. Android 14 (API 34) requires
         the typed permission; the app never asks for ACCESS_BACKGROUND_LOCATION,
         because a running location foreground service is in use. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13 (API 33) shows the foreground notification only when this
         runtime permission is granted; the activity asks for it when guidance
         starts and navigation still runs if the answer is no. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="nl.r1a.grassmap.app.GrassMapsApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="nl.r1a.grassmap.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T-0416: a GPX another app shares to Grass Maps. Android's MIME
                 map has no entry for the gpx extension, so a file manager or a
                 messenger sends the document as application/octet-stream;
                 both types are declared or the row never appears for a real
                 file. The app reads the URI through the grant the share intent
                 carries, so no storage permission is declared, and a document
                 that is not a track answers with a notice instead of being
                 silently ignored. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- T-0211: geo: links and osm.org pages from other apps. The app
                 offers itself as the default maps app through this filter. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.openstreetmap.org" />
                <data android:scheme="http" android:host="www.openstreetmap.org" />
                <data android:scheme="https" android:host="openstreetmap.org" />
                <data android:scheme="http" android:host="openstreetmap.org" />
                <data android:scheme="https" android:host="osm.org" />
                <data android:scheme="http" android:host="osm.org" />
                <data android:scheme="https" android:host="www.osm.org" />
                <data android:scheme="http" android:host="www.osm.org" />
                <!-- Only the paths the router opens. Android flattens the data
                     lists of one filter, so these paths apply to every host
                     above; the root path is the permalink form. -->
                <data android:path="/" />
                <data android:pathPrefix="/node/" />
                <data android:pathPrefix="/way/" />
                <data android:pathPrefix="/relation/" />
                <data android:pathPrefix="/go/" />
            </intent-filter>
        </activity>
        <!-- T-0410: the only FileProvider in the main app. It exposes the
             cache directory a shared track is staged in, one file at a time,
             with a read grant on the send intent. No storage permission is
             declared and no other directory is reachable. -->
        <provider
            android:name="nl.r1a.grassmap.app.TrackFileProvider"
            android:authorities="${applicationId}.track.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/track_file_paths" />
        </provider>

        <!-- T-0314: guidance runs here while the activity is not in the
             foreground. It starts and stops with a navigation session, never on
             its own; stopWithTask stays false so navigation survives a task
             swipe and stopWithTask cannot release location early. -->
        <service
            android:name="nl.r1a.grassmap.app.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
    </application>
</manifest>
