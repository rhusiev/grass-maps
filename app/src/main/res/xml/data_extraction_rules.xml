<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules (API 31+). `backup_rules.xml` holds the same set for
  API 23-30.

  Only the user-data stores are included: favourites, tracks (with their sidecar
  and planned-route records) and the search and route histories. Naming an
  include excludes everything else under the app's storage, so region packages,
  diagnostics and map fixtures never enter a cloud backup or a device-to-device
  transfer. The cache directory is never part of either mechanism.
  `tracks/.trash` sits inside the included track directory, so it takes an
  explicit exclude.

  `disableIfNoEncryptionCapabilities` is false: the user decided on 2026-11-14
  that a backup happens whatever the device's lock-screen state, so a phone
  without one still keeps its favourites, tracks and histories. The rules still
  limit what may enter a backup; the lock screen is not the gate.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <include domain="file" path="favourites/favourites.gpx" />
        <include domain="file" path="tracks" />
        <include domain="file" path="history/search-history.json" />
        <include domain="file" path="history/route-history.json" />
        <exclude domain="file" path="tracks/.trash" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="favourites/favourites.gpx" />
        <include domain="file" path="tracks" />
        <include domain="file" path="history/search-history.json" />
        <include domain="file" path="history/route-history.json" />
        <exclude domain="file" path="tracks/.trash" />
    </device-transfer>
</data-extraction-rules>
