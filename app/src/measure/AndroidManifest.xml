<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The measurement build adds one launcher screen and a share provider to
         the release manifest. Neither `release` nor `benchmark` includes this
         source set, so the screen and the pack assets cannot ship outside the
         measure build type. -->
    <application>
        <activity
            android:name="nl.r1a.grassmap.app.MeasureActivity"
            android:exported="true"
            android:label="Grass Maps Measure"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares the report file with the app the user picks. No network is
             involved; the provider is scoped to the measurement directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.measure.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/measure_file_paths" />
        </provider>
    </application>
</manifest>
