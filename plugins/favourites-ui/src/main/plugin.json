        "params": "kotlinx.serialization.json.JsonElement",
        "result": "nl.r1a.grassmap.plugin.api.model.FavouriteListsState",
        "doc": "Filters the favourites screen by name and description. Parameter: query.",
        "undoable": false,
        "allowlistedForControl": false,
        "dispatcher": "io",
        "implementation": "nl.r1a.grassmap.plugins.favourites.ui.SearchFavouritesCommand"
      },
      {
        "id": "favourites.ui.set_sort",
        "params": "kotlinx.serialization.json.JsonElement",
        "result": "nl.r1a.grassmap.plugin.api.model.FavouriteListsState",
