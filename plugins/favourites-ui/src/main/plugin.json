        "params": "kotlinx.serialization.json.JsonElement",
        "result": "nl.r1a.grassmap.plugin.api.model.FavouriteListsState",
        "doc": "Sets a favourite as Work. Parameter: pointId.",
        "undoable": false,
        "allowlistedForControl": true,
        "dispatcher": "io",
        "implementation": "nl.r1a.grassmap.plugins.favourites.ui.SetWorkFavouriteCommand"
      },
      {
