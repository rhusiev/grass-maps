{
  "id": "favourites.ui",
  "name": "plugin.favourites_ui.name",
  "description": "plugin.favourites_ui.description",
  "version": "0.1.0",
  "api": "0.1.0",
  "implementation": "nl.r1a.grassmap.plugins.favourites.ui.FavouritesUiPlugin",
  "contributes": {
    "commands": [
      {
