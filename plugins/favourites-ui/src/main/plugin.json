        "params": "kotlinx.serialization.json.JsonElement",
        "result": "nl.r1a.grassmap.plugin.api.model.FavouriteListsState",
        "doc": "Undoes the latest lists action and returns the state.",
        "undoable": false,
        "allowlistedForControl": true,
        "dispatcher": "io",
        "implementation": "nl.r1a.grassmap.plugins.favourites.ui.UndoFavouriteListCommand"
      },
      {
