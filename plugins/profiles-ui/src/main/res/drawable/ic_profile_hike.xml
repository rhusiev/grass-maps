<?xml version="1.0" encoding="utf-8"?>
<!--
  The pinned hike pictogram: the mountain drawn in round9/k-browse.html's
  bottom bar. Paths are the "hike" icon from round9/_build/ui.py, on its 24 px
  grid. The peak is stroked with a round join; the snow line is stroked too.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M2.5,20L9.5,8L13.5,14.5L16,11L21.5,20Z"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M7.6,11.2L9.5,12.8L11.4,11.2"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
