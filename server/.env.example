# Copy to .env. Every value shown is the default.

# 1 = a request needs a valid bearer token, 0 = open server
GM_REQUIRE_TOKENS=1
# With tokens off, limits and quota count per client IP ("ip") or for all clients together ("global")
GM_ANON_KEY=ip
# Requests per key per minute, simultaneous downloads per key, monthly GiB per key (0 = no limit)
GM_RATE_PER_MINUTE=60
GM_MAX_CONCURRENT=4
GM_QUOTA_GIB=20
# Failed token checks per GM_BAN_WINDOW_S from one IP before it is banned for GM_BAN_SECONDS
GM_BAN_FAILURES=20
GM_BAN_WINDOW_S=600
GM_BAN_SECONDS=3600
# Where the packs live on the host, and the user the container runs as
GM_PACKS_HOST_DIR=./packs
GM_UID=10001
GM_GID=10001
